{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-destroy",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/motor_ia",
          "sidecar": true
        }
      ]
    }
  ]
}